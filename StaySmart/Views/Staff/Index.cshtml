@model List<Booking>
@{ ViewData["Title"]="Staff dashboard"; }
<section class="section staff-page"><div class="staff-heading"><div><span class="eyebrow">STAYSMART · OPERATIONS</span><h1>Good hospitality starts <em>here.</em></h1><p class="muted">A quick view of the stays and guests on your radar.</p></div><div class="btn-row"><a class="btn btn-dark" asp-action="Bookings">All bookings ↗</a><a class="btn btn-outline" asp-action="Rooms">@(User.IsInRole("Admin") ? "Manage rooms" : "View rooms")</a>@if(User.IsInRole("Admin")){<a class="btn btn-outline" asp-controller="Admin" asp-action="Users">Users</a>}</div></div>@if(TempData["Message"]!=null){<div class="notice">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="validation">@TempData["Error"]</div>}<div class="stats-grid"><div class="stat-card"><span>Active rooms</span><strong>@ViewBag.RoomCount</strong><small>Ready for guests</small></div><div class="stat-card"><span>Bookings</span><strong>@ViewBag.BookingCount</strong><small>Not cancelled</small></div><div class="stat-card"><span>Arriving today</span><strong>@ViewBag.Arrivals</strong><small>Confirmed check-ins</small></div><div class="stat-card"><span>Booked value</span><strong>₹@(((decimal)ViewBag.Revenue).ToString("N0"))</strong><small>Before refunds / taxes</small></div></div><div class="table-card"><div class="table-heading"><div><h2>Recent reservations</h2><p>Latest 12 booking records</p></div></div><div class="table-scroll"><table><thead><tr><th>Guest</th><th>Room</th><th>Dates</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><strong>@b.GuestName</strong><small>@b.Email</small><small class="ref">@b.BookingReference</small></td><td>@b.Room?.Name</td><td>@b.CheckIn.ToString("dd MMM") – @b.CheckOut.ToString("dd MMM")</td><td>₹@b.TotalPrice.ToString("N0")</td><td><span class="status status-@b.Status.ToString().ToLower()">@b.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="inline-form"><input type="hidden" name="id" value="@b.Id"/><select name="status"><option value="Confirmed">Confirmed</option><option value="CheckedIn">Checked in</option><option value="CheckedOut">Checked out</option><option value="Cancelled">Cancelled</option></select><button class="mini-btn">Save</button></form></td></tr>}</tbody></table></div></div></section>
