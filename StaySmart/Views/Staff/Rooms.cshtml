@model List<Room>
@{ ViewData["Title"]="Manage rooms"; }
<section class="section staff-page"><div class="staff-heading"><div><span class="eyebrow">STAYSMART · INVENTORY</span><h1>Every room, <em>in good hands.</em></h1></div>@if(User.IsInRole("Admin")){<a class="btn btn-dark" asp-action="CreateRoom">+ Add a room</a>}</div>@if(TempData["Message"]!=null){<div class="notice">@TempData["Message"]</div>}<div class="table-card"><div class="table-scroll"><table><thead><tr><th>Room</th><th>Category</th><th>Capacity</th><th>Rate / night</th><th>Availability</th><th>Action</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@r.Name</strong><small>Room @r.RoomNumber</small></td><td>@r.Category</td><td>@r.Capacity guests</td><td>₹@r.PricePerNight.ToString("N0")</td><td>@(r.IsActive?"Active":"Hidden")</td><td>@if(User.IsInRole("Admin")){<a class="mini-btn" asp-action="EditRoom" asp-route-id="@r.Id">Edit</a> <form class="inline-form" asp-action="ToggleRoom" method="post"><input type="hidden" name="id" value="@r.Id"/><button class="mini-btn" type="submit">@(r.IsActive?"Hide room":"Activate")</button></form>}</td></tr>}</tbody></table></div></div></section>
