@model Room
@{ ViewData["Title"]="Add room"; }
<section class="section form-page"><div class="form-card narrow"><span class="eyebrow">INVENTORY MANAGEMENT</span><h1>Add a <em>room.</em></h1><form asp-action="CreateRoom" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label asp-for="RoomNumber">Room number<input asp-for="RoomNumber"/><span asp-validation-for="RoomNumber"></span></label><label asp-for="Name">Display name<input asp-for="Name"/><span asp-validation-for="Name"></span></label><label asp-for="Category">Category<select asp-for="Category"><option>Deluxe</option><option>Suite</option><option>Family</option><option>Business</option><option>Standard</option></select></label><label asp-for="Capacity">Guest capacity<input asp-for="Capacity" type="number" min="1" max="10"/><span asp-validation-for="Capacity"></span></label><label asp-for="PricePerNight">Price per night (₹)<input asp-for="PricePerNight" type="number" min="1" step="0.01"/><span asp-validation-for="PricePerNight"></span></label><label asp-for="ImageUrl">Image URL<input asp-for="ImageUrl"/><span asp-validation-for="ImageUrl"></span></label><label class="full-field" asp-for="Description">Description<textarea asp-for="Description" rows="3"></textarea></label><label class="full-field" asp-for="Amenities">Amenities (comma separated)<textarea asp-for="Amenities" rows="2"></textarea></label></div><label class="check-label"><input asp-for="IsActive"/> Available to guests</label><button class="btn btn-dark btn-wide" type="submit">Save room ↗</button></form></div></section>
