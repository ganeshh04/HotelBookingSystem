@model Room
@{ ViewData["Title"]=Model.Name; }
<section class="section detail-page"><a class="back-link" asp-controller="Home" asp-action="Index">← Back to rooms</a><div class="detail-grid"><img class="detail-image" src="@Model.ImageUrl" alt="@Model.Name"/><div class="detail-copy"><span class="eyebrow">@Model.Category ROOM · @Model.RoomNumber</span><h1>@Model.Name</h1><p class="lead">@Model.Description</p><div class="detail-price"><strong>₹@Model.PricePerNight.ToString("N0")</strong> / night <small class="muted">· +20% on Friday &amp; Saturday nights</small></div><hr/><h3>The little things</h3><div class="amenity-list">@foreach(var item in Model.Amenities.Split(',')){<span>✦ @item.Trim()</span>}</div><h3>Already booked</h3>@{ var booked = (List<BookedRange>)ViewBag.Booked; }@if(!booked.Any()){<p class="muted">No upcoming reservations — every date is open.</p>}else{<ul class="booked-list">@foreach(var br in booked){<li><span class="booked-dot"></span>@br.CheckIn.ToString("dd MMM yyyy") – @br.CheckOut.ToString("dd MMM yyyy")</li>}</ul><p class="fine-print">Check-out day is free for a new arrival. Pick dates outside these ranges.</p>}<p class="room-meta">Comfortably accommodates @Model.Capacity guests.</p><a class="btn btn-dark btn-wide" asp-controller="Bookings" asp-action="Create" asp-route-roomId="@Model.Id">Choose this room ↗</a></div></div></section>
