@model List<Room>
@{ ViewData["Title"]="Find your next stay"; }
<section class="hero"><div class="hero-shade"></div><div class="hero-content"><span class="eyebrow light">A STAY THAT FEELS LIKE YOU</span><h1>Make room for<br><em>something lovely.</em></h1><p>Beautiful rooms, thoughtful details, and a booking experience that just feels easy.</p></div><div class="search-panel"><form method="get" asp-controller="Home" asp-action="Index" class="search-grid"><label>CHECK IN<input type="date" name="checkIn" value="@ViewBag.CheckIn" required /></label><label>CHECK OUT<input type="date" name="checkOut" value="@ViewBag.CheckOut" required /></label><label>GUESTS<select name="guests"><option value="1" selected="@(ViewBag.Guests==1)">1 guest</option><option value="2" selected="@(ViewBag.Guests==2)">2 guests</option><option value="3" selected="@(ViewBag.Guests==3)">3 guests</option><option value="4" selected="@(ViewBag.Guests==4)">4 guests</option></select></label><button class="btn btn-dark" type="submit">Find a room <span>↗</span></button></form></div></section>
<section class="ai-banner"><span>✦ Not sure which room fits?</span> <a class="text-link" asp-controller="Concierge" asp-action="Index">Ask our AI concierge →</a></section>
<section class="section rooms-section"><div class="section-heading"><div><span class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</span><h2>Stay a little <em>better.</em></h2><p>Handpicked spaces for every kind of traveller.</p></div><div class="availability-note"><span class="live-dot"></span> Live availability <small>for your selected dates</small></div></div>
@if(!Model.Any()){<div class="empty-state"><h3>No rooms found for those dates</h3><p>Try changing your dates or reducing the number of guests.</p><a class="btn btn-outline" asp-action="Index">Reset search</a></div>}else{<div class="room-grid">@foreach(var room in Model){<article class="room-card"><a class="room-image" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id"><img src="@room.ImageUrl" alt="@room.Name"/><span class="room-tag">@room.Category stay</span><span class="image-arrow">↗</span></a><div class="room-info"><div class="room-title-row"><h3>@room.Name</h3><span class="rating">✦ 4.9</span></div><p class="room-meta">Room @room.RoomNumber · Up to @room.Capacity guests</p><p class="room-desc">@room.Description</p><div class="amenity-row">@string.Join(" · ", room.Amenities.Split(',').Take(3).Select(a=>a.Trim()))</div><div class="room-bottom"><div><strong>₹@room.PricePerNight.ToString("N0")</strong><span> / night</span></div><a class="text-link" asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.Id" asp-route-checkIn="@ViewBag.CheckIn" asp-route-checkOut="@ViewBag.CheckOut" asp-route-guests="@ViewBag.Guests">Book stay <span>→</span></a></div></div></article>}</div>}
</section><section class="promise"><div><span class="promise-icon">✳</span><h3>Book with confidence</h3><p>Clear pricing. No hidden surprises.</p></div><div><span class="promise-icon">⌂</span><h3>Made for real rest</h3><p>Rooms chosen for comfort and calm.</p></div><div><span class="promise-icon">♡</span><h3>Human hospitality</h3><p>Thoughtful details at every step.</p></div></section>
