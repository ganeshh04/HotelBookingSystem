@model BookingInput
@{ ViewData["Title"]="Reserve your stay"; var room=(Room)ViewBag.Room; var price=PriceCalculator.Calculate(room.PricePerNight,Model.CheckIn,Model.CheckOut); var nights=Math.Max(1,price.Nights); }
<section class="section form-page"><a class="back-link" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id">← Back to room</a><div class="booking-layout"><div class="form-card"><span class="eyebrow">JUST A FEW DETAILS</span><h1>Let's make it <em>official.</em></h1><p class="muted">Tell us who's checking in. Your getaway is almost here.</p><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="RoomId" type="hidden"/><div class="form-grid"><label asp-for="GuestName">Full name<input asp-for="GuestName" placeholder="Your full name" autocomplete="name"/><span asp-validation-for="GuestName"></span></label><label asp-for="Email">Email address<input asp-for="Email" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email"></span></label><label asp-for="Phone">Phone number<input asp-for="Phone" placeholder="+91 98765 43210" autocomplete="tel"/><span asp-validation-for="Phone"></span></label><label asp-for="Guests">Guests<select asp-for="Guests">@for(var i=1;i<=room.Capacity;i++){<option value="@i">@i @(i==1?"guest":"guests")</option>}</select><span asp-validation-for="Guests"></span></label><label asp-for="CheckIn">Check-in<input asp-for="CheckIn" type="date"/><span asp-validation-for="CheckIn"></span></label><label asp-for="CheckOut">Check-out<input asp-for="CheckOut" type="date"/><span asp-validation-for="CheckOut"></span></label><label class="full-field" asp-for="SpecialRequest">Special requests <small>(optional)</small><textarea asp-for="SpecialRequest" rows="3" placeholder="Anything that would make your stay special?"></textarea><span asp-validation-for="SpecialRequest"></span></label></div><button class="btn btn-dark btn-wide" type="submit">Confirm booking <span>↗</span></button><p class="fine-print">No payment is collected in this demo. Your booking is stored in the hotel database.</p></form></div><aside class="summary-card"><img src="@room.ImageUrl" alt="@room.Name"/><span class="eyebrow">YOUR SELECTED STAY</span><h3>@room.Name</h3><p class="room-meta">@room.Category · Up to @room.Capacity guests</p><div class="summary-line"><span>Rate per night</span><strong>₹@room.PricePerNight.ToString("N0")</strong></div><div class="summary-line"><span>Duration</span><strong id="night-count">@nights nights</strong></div><div class="summary-total"><span>Estimated total</span><strong id="total-price">₹@price.Total.ToString("N0")</strong></div><p class="fine-print" id="weekend-note">@(price.WeekendNights>0 ? $"Includes {price.WeekendNights} weekend night(s) at +20%." : "Friday & Saturday nights carry a 20% weekend surcharge.")</p><p class="fine-print">The final price is always calculated by the server. No payment is taken in this demo.</p></aside></div></section>

