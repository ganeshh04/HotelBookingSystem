@{ ViewData["Title"]="Find my booking"; }
<section class="section find-page"><div class="form-card find-card"><span class="eyebrow">YOUR PLANS, AT YOUR FINGERTIPS</span><h1>Find your <em>booking.</em></h1><p class="muted">Enter the reference from your confirmation and the email used to book.</p>@if(ViewBag.Error!=null){<div class="validation">@ViewBag.Error</div>}<form asp-action="Find" method="post"><div class="form-grid single"><label>Booking reference<input name="reference" required placeholder="e.g. A1B2C3D4"/></label><label>Email address<input name="email" type="email" required placeholder="you@example.com"/></label></div><button class="btn btn-dark btn-wide" type="submit">Find my stay ↗</button></form></div></section>
