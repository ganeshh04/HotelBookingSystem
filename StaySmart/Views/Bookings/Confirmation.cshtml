@model Booking
@{ ViewData["Title"]="Booking confirmed"; }
<section class="section confirmation-wrap"><div class="confirmation-card"><div class="success-icon">✓</div><span class="eyebrow">IT'S OFFICIALLY A GETAWAY</span><h1>Your stay is <em>confirmed.</em></h1><p class="muted">We've saved your booking. Keep this reference handy to look it up later.</p><div class="reference-box"><span>BOOKING REFERENCE</span><strong>@Model.BookingReference</strong></div><img class="confirmation-image" src="@Model.Room?.ImageUrl" alt="@Model.Room?.Name"/><h2>@Model.Room?.Name</h2><div class="confirm-details"><div><span>Guest</span><strong>@Model.GuestName</strong></div><div><span>Check-in</span><strong>@Model.CheckIn.ToString("ddd, dd MMM yyyy")</strong></div><div><span>Check-out</span><strong>@Model.CheckOut.ToString("ddd, dd MMM yyyy")</strong></div><div><span>Guests</span><strong>@Model.Guests</strong></div><div><span>Duration</span><strong>@((Model.CheckOut-Model.CheckIn).Days) nights</strong></div><div><span>Total estimate</span><strong>₹@Model.TotalPrice.ToString("N0")</strong></div></div><p class="fine-print">Demo booking only: no email or payment has been processed.</p><a class="btn btn-dark btn-wide" asp-controller="Home" asp-action="Index">Explore more rooms ↗</a></div></section>
